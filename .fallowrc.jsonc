{
  "$schema": "https://docs.fallow.tools/schema/fallow.schema.json",

  // The Vendure backend lives in vendure-showcase/server but is installed and
  // run on its own (tsx watch src/index.ts) — it is intentionally NOT part of
  // the frontend bun workspace install. Declare its real entry points so its
  // files aren't reported as unreachable dead code.
  "workspaces": {
    "patterns": ["vendure-showcase/server"]
  },
  "entry": [
    "vendure-showcase/server/src/index.ts",
    "vendure-showcase/server/src/seed.ts",
    // Vendure Admin-UI extensions are loaded by file path via
    // compileUiExtensions(), not by a traceable import — treat them as entries.
    "vendure-showcase/server/src/plugins/**/ui/**/*.{ts,tsx}"
  ],

  "ignoreDependencies": [
    // --- Separately-managed Vendure backend (vendure-showcase/server) ---
    // Imported only in the server, which installs on its own. Some are direct
    // deps of server/package.json, others resolve transitively via @vendure/core
    // and @vendure/ui-devkit. The frontend monorepo neither installs nor polices them.
    "@vendure/core",
    "@vendure/admin-ui",
    "@vendure/admin-ui-plugin",
    "@vendure/asset-server-plugin",
    "@vendure/ui-devkit",
    "@nestjs/graphql",
    "@angular/core",
    "graphql-tag",

    // --- urql peer dependency (vendure-showcase/storefront) ---
    // Required at runtime by urql / @urql/core but never imported directly.
    "graphql",

    // --- vite single-instance pins (components-showcase / section-showcase) ---
    // Declared in the showcase package.json on purpose: vite.config.ts pins them
    // to one copy via the nm() alias helper (single-copy resolution for React
    // context libs). Consumed through the @components workspace alias, so fallow
    // sees no direct import and wrongly flags them as unused. Not dead — load-bearing.
    "@ark-ui/react",
    "@chenglou/pretext",
    "@number-flow/react",
    "@tanstack/react-form",
    "@tanstack/react-hotkeys",
    "canvas-confetti",
    "clsx",
    "motion",
    "tailwind-merge"
  ],

  // Exports/types fallow can't see a consumer for, but which are intentional.
  // Genuinely-internal leaked `export`s were instead un-exported in code; what
  // remains here is real public surface / framework-loaded / WIP.
  "ignoreExports": [
    // --- Public deep-import library API ---
    // Component props/option/ref types and component variants ARE the product;
    // the in-repo showcase doesn't import every one. Not dead.
    { "file": "components/animated-icons/animated-icons.tsx", "exports": ["ChevronDownIconCss", "ChevronRightIconCss", "UserIconCss", "PlusIconCss", "MinusIconCss", "TruckIconCss"] },
    { "file": "components/navbar/navbar.tsx", "exports": ["NavbarMobileOnly"] },
    { "file": "components/scroll-rotate/scroll-rotate.tsx", "exports": ["ScrollRotate"] },
    { "file": "components/toast/toast-context.ts", "exports": ["toast"] },
    { "file": "components/confetti/fire.ts", "exports": ["fireConfettiRain"] },
    { "file": "components/aurora-text/aurora-text.tsx", "exports": ["AuroraTextProps"] },
    { "file": "components/form-input/form-input.tsx", "exports": ["FormInputProps"] },
    { "file": "components/text-rotate/text-rotate.tsx", "exports": ["TextRotateRef", "TextRotateProps"] },
    { "file": "components/velocity-scroll/velocity-scroll.tsx", "exports": ["Testimonial"] },
    { "file": "components/view-transition/run-view-transition.ts", "exports": ["StartViewTransitionOptions"] },
    { "file": "components/view-transition/transition-stage.tsx", "exports": ["TransitionStageProps"] },

    // --- Public entry barrels (documented import paths: @components/atelier, @components/i18n) ---
    { "file": "components/atelier/index.ts", "exports": ["*"] },
    { "file": "components/i18n/index.ts", "exports": ["*"] },

    // --- cellar-canvas: WIP domain-app engine/types, consumed in later phases ---
    { "file": "components/cellar-canvas/**", "exports": ["*"] },

    // --- Vendure backend: NestJS DI-registered resolver, not a traceable import ---
    { "file": "vendure-showcase/server/**", "exports": ["*"] },

    // --- Storefront lib consumed by .astro islands fallow doesn't fully parse ---
    { "file": "vendure-showcase/storefront/src/lib/**", "exports": ["*"] }
  ],

  // Duplication: the library is built from self-contained components, each with
  // an injected keyframe block (COMPONENT-GUIDELINES §4c — local STYLE_ID +
  // injectStyles() dedup). Unrelated components therefore share a near-identical
  // skeleton (props interface → STYLE_ID → injectStyles → state shell). That
  // structural similarity is by design, not copy-paste, and is the price of the
  // self-contained/portable module decision. Tune to literal cross-dir clones
  // (weak + skipLocal), drop demo/WebGL noise, and ignore the component files
  // whose only "duplication" is that shared convention skeleton.
  "duplicates": {
    "mode": "weak",
    "skipLocal": true,
    "minLines": 30,
    "ignore": [
      "components/splash-cursor/**",
      "components-showcase/src/pages/**",
      "section-showcase/src/**",
      "**/vite.config.ts",
      "components/backlight/**",
      "components/bounce-loader/**",
      "components/breadcrumb/**",
      "components/heart-like/**",
      "components/magnetic-button/**",
      "components/paragraph/**",
      "components/password-confirmation/**",
      "components/password-setup/**",
      "components/use-image-upload/**",
      "components/click-spark/**",
      "components/highlighter/**",
      "components/shiny-text/**",
      "components/sparkles-text/**",
      "components/lens/**",
      "components/timeline/**",
      "components/form-input/**",
      "components/images-slider/**"
    ]
  },

  // Health/complexity: exclude code that is large by nature and not a signal of
  // library quality — the ported WebGL fluid sim, showcase demo pages, Vendure
  // seed data, and build configs. Real components keep the default gates.
  "health": {
    "ignore": [
      "components/splash-cursor/**",
      "components-showcase/src/pages/**",
      "section-showcase/src/**",
      "vendure-showcase/server/src/seed.ts",
      "**/vite.config.ts"
    ]
  }
}
