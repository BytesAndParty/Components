{
  "name": "@local/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "security:audit": "bun audit --audit-level=critical",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vendure": "playwright test --config playwright.vendure.config.ts",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "build:all": "bun run scripts/build-all.mjs"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild"
  ],
  "workspaces": [
    "components",
    "launcher",
    "components-showcase",
    "section-showcase",
    "vendure-showcase/storefront"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
