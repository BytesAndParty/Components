{
  "name": "@local/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "security:audit": "bun audit --audit-level=critical",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:vendure": "playwright test --config playwright.vendure.config.ts",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "build:all": "bun run scripts/build-all.mjs"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild"
  ],
  "workspaces": [
    "components",
    "launcher",
    "components-showcase",
    "section-showcase",
    "vendure-showcase/storefront"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tanstack/eslint-plugin-query": "^5.101.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "devalue": "^5.8.1"
  }
}
