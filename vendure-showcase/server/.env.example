# ── Datenbank ────────────────────────────────────────────────────────────────
# Leer lassen → SQLite (lokale Entwicklung, kein Setup nötig)
# Auf "postgres" setzen → PostgreSQL (Podman / Produktion)
DB_TYPE=

# Nur relevant wenn DB_TYPE=postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wine_server
DB_USER=vendure
DB_PASSWORD=vendure_pw

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
ADMIN_PORT=3002

# Erlaubte Origins für CORS (kommagetrennt). Wirkt nur mit NODE_ENV=production —
# in dev ist jede Origin erlaubt. Leer in Produktion → keine Cross-Origin-Requests
# (das Dashboard läuft same-origin und braucht kein CORS).
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# Öffentliche Basis-URL hinter dem Reverse Proxy (nur Produktion), ohne Slash am Ende.
# Daraus wird der assetUrlPrefix (<PUBLIC_API_URL>/assets/).
PUBLIC_API_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
COOKIE_SECRET=change-me-in-production

NODE_ENV=development

# ── Storefront-Deploy ────────────────────────────────────────────────────────
# Netlify Build Hook URL (Site settings → Build & deploy → Build hooks → Add).
# Der „Veröffentlichen"-Button im Dashboard POSTet hierauf und stößt einen
# Rebuild + Deploy der statischen Astro-Storefront an.
# Leer lassen → Button meldet "Kein Build-Hook konfiguriert".
NETLIFY_BUILD_HOOK_URL=
