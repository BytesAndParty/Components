# Build-Kontext = vendure-showcase/server (eigenständiges Bun-Projekt, kein Workspace):
#   podman build -f Containerfile -t vendure-showcase-server .
# Image-Refs voll qualifiziert — Podman auf dem VPS hat keine unqualified-search-registries.

# ── Build Stage: Server (tsc) + Dashboard (vite) ─────────────────────────────
FROM docker.io/oven/bun:1-slim AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

# ── Nur Produktions-Dependencies ─────────────────────────────────────────────
FROM docker.io/oven/bun:1-slim AS prod-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

# ── Runtime Stage ────────────────────────────────────────────────────────────
FROM docker.io/library/node:22-slim
ENV NODE_ENV=production
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./

# Daten-Verzeichnis für Assets (wird als Volume gemountet)
RUN mkdir -p data/assets

EXPOSE 3000

CMD ["node", "dist/index.js"]
