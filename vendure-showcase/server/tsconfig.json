{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/plugins/**/dashboard/*",
    "src/gql/*",
    "vite.config.mts"
  ],
  "references": [
    { "path": "./tsconfig.dashboard.json" }
  ]
}
