---
/**
 * ALLES ZWISCHEN DEN '---' LÄUFT NUR BEIM BUILD (NODE.JS)
 * Daten von Vendure ins HTML einbacken — Produkt-Grid + Filter-UI
 * sind beim First Paint sichtbar, ohne Lade-Flackern.
 */
import Layout from '@/layouts/Layout.astro';
import { StorePage } from '@/components/react/store/StorePage';
import { shopApiRequest } from '@/lib/vendure-client';
import { GET_FACETS, GET_PRODUCTS } from '@/lib/queries';
import type { Facet, Product } from '@/lib/types';

const [productsData, facetsData] = await Promise.all([
	shopApiRequest<{ products: { items: Product[] } }>(GET_PRODUCTS),
	shopApiRequest<{ facets: { items: Facet[] } }>(GET_FACETS),
]);

const initialProducts = productsData.products.items;
const initialFacets = facetsData.facets.items;
---

<Layout title="Unsere Weine">
	<main class="max-w-6xl mx-auto px-6 py-10">
		<StorePage
			client:load
			initialProducts={initialProducts}
			initialFacets={initialFacets}
		/>
	</main>
</Layout>
